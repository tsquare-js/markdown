{
  "name": "rehype-tsquare",
  "version": "0.2.0",
  "description": "rehype plugin that turns tsquare code blocks into wireframe images at build time: Docusaurus, Astro, Starlight, Next.js with MDX, anything on unified.",
  "keywords": [
    "rehype",
    "rehype-plugin",
    "unified",
    "html",
    "mdx",
    "docusaurus",
    "astro",
    "starlight",
    "tsquare",
    "wireframe"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsquare-js/markdown.git",
    "directory": "packages/rehype-tsquare"
  },
  "homepage": "https://tsquare.dev/docs/markdown-plugins#rehype-tsquare",
  "bugs": {
    "url": "https://github.com/tsquare-js/markdown/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./client.standalone.js": "./dist/client.standalone.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "./dist/client.js",
    "./dist/client.standalone.js"
  ],
  "dependencies": {
    "@types/hast": "^3.0.4",
    "tsquare": "^0.13.2 || ^0.14.0",
    "vfile": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
