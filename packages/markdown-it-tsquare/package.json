{
  "name": "markdown-it-tsquare",
  "version": "0.2.0",
  "description": "markdown-it plugin that turns ```tsquare code blocks into wireframe images at build time: VitePress, Eleventy, anything on markdown-it.",
  "keywords": [
    "markdown-it",
    "markdown-it-plugin",
    "vitepress",
    "eleventy",
    "tsquare",
    "wireframe",
    "markdown"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsquare-js/markdown.git",
    "directory": "packages/markdown-it-tsquare"
  },
  "homepage": "https://github.com/tsquare-js/markdown/tree/main/packages/markdown-it-tsquare#readme",
  "bugs": {
    "url": "https://github.com/tsquare-js/markdown/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./client.standalone.js": "./dist/client.standalone.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "./dist/client.js",
    "./dist/client.standalone.js"
  ],
  "dependencies": {
    "@types/markdown-it": "^14.1.2",
    "hast-util-to-html": "^9.0.5",
    "synckit": "^0.11.13",
    "tsquare": "^0.13.2"
  },
  "engines": {
    "node": ">=20"
  }
}
