{
  "name": "tsquare-markdown",
  "private": true,
  "description": "Build-time plugins that turn ```tsquare code blocks into wireframe images: remark-tsquare and markdown-it-tsquare.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@types/hast": "^3.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "unified": "^11.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
